# Copy to .env.local (development) or set on your host (production).

# Password for the team dashboard at /admin. Required in production —
# without it the dashboard stays locked. (Development default: drp-admin)
ADMIN_PASSWORD=

# Secret used to sign booking links and admin sessions (32+ random chars).
# If unset, one is generated and stored with the data.
APP_SECRET=

# Upstash Redis — REQUIRED on Vercel (read-only filesystem). Vercel's
# "Upstash for Redis" integration sets these two automatically.
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are also accepted.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Without Redis: folder for the JSON data files. Must be on a persistent
# disk. Default: ./.data
DATA_DIR=

# Public URL used in email links. Default: site.url in src/config/site.ts
SITE_URL=

# Transactional email via Resend (https://resend.com). Without these,
# emails are printed to the server log instead of being sent.
RESEND_API_KEY=
MAIL_FROM="DRP Holiday Homes <stay@drpholidayhomes.ae>"

# Online card payment with Stripe (https://dashboard.stripe.com/apikeys).
# When STRIPE_SECRET_KEY is set, guests pay on Stripe Checkout and the stay
# is confirmed automatically; without it, bookings are requests the team
# confirms. Use sk_test_… keys to test, sk_live_… to take real payments.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<your-site>/api/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired).
STRIPE_WEBHOOK_SECRET=

# Photo uploads in the admin "Homes" page (Vercel → Storage → Blob sets this).
# Without it you can still paste image addresses.
BLOB_READ_WRITE_TOKEN=

# Secret for /api/cron/ical (Airbnb calendar refresh). Vercel Cron sends it
# automatically; any random string works.
CRON_SECRET=

# Inbox that receives new booking / enquiry notifications.
# Default: site.email in src/config/site.ts
NOTIFY_EMAIL=

# Optional analytics and live chat (public IDs). Each is only loaded after a
# visitor accepts cookies in the consent banner, which appears only when at
# least one of these is set.
# Google Analytics 4, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# Tawk.to embed URL, e.g. https://embed.tawk.to/PROPERTY_ID/WIDGET_ID
NEXT_PUBLIC_TAWK_SRC=

# Optional: manage homes, Airbnb and availability from the D|R|P portal. When set, the homes
# published in the portal replace the built-in list and website bookings are pushed to the portal.
# The key must equal WEBSITE_API_KEY on the portal.
PORTAL_API_URL=
PORTAL_API_KEY=
